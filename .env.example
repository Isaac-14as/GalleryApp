# Copy this file to .env and replace every CHANGE_ME value.
#
# Test deployment by public IP (example: 203.0.113.10):
# SITE_ADDRESS=http://203.0.113.10
# PUBLIC_ORIGIN=http://203.0.113.10
# MINIO_SITE_ADDRESS=http://203.0.113.10:9003
# MINIO_PUBLIC_URL=http://203.0.113.10:9003
# MINIO_HOST=203.0.113.10
# MINIO_PORT=9003
# MINIO_SECURE=false
#
# Deployment with domains:
# SITE_ADDRESS=example.com
# PUBLIC_ORIGIN=https://example.com
# MINIO_SITE_ADDRESS=storage.example.com
# MINIO_PUBLIC_URL=https://storage.example.com
# MINIO_HOST=storage.example.com
# MINIO_PORT=443
# MINIO_SECURE=true

SITE_ADDRESS=http://CHANGE_ME_SERVER_IP
PUBLIC_ORIGIN=http://CHANGE_ME_SERVER_IP

MINIO_SITE_ADDRESS=http://CHANGE_ME_SERVER_IP:9003
MINIO_PUBLIC_URL=http://CHANGE_ME_SERVER_IP:9003
MINIO_HOST=CHANGE_ME_SERVER_IP
MINIO_PORT=9003
MINIO_SECURE=false

POSTGRES_USER=gallery
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=gallery

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD

MINIO_ROOT_USER=gallery-storage
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_STORAGE_PASSWORD
MINIO_GET_EXPIRE_MINUTES=360
MINIO_PUT_EXPIRE_MINUTES=60
